
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Todas las compilaciones dentro de artifacts -->
    <BaseOutputPath>artifacts/bin/</BaseOutputPath>

    <!-- Archivos intermedios -->
    <BaseIntermediateOutputPath>artifacts/obj/</BaseIntermediateOutputPath>

    <!-- Publicación Release -->
    <PublishDir>artifacts/bin/$(Configuration)/$(TargetFramework)/publish/</PublishDir>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
  </ItemGroup>

</Project>
