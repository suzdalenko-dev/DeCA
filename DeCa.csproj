<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Compilación fuera del proyecto -->
    <BaseOutputPath>..\DeCa_Build\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>..\DeCa_Build\obj\</BaseIntermediateOutputPath>

     <!-- Publicación también fuera -->
    <PublishDir>..\DeCa_Build\bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
  </ItemGroup>


</Project>
